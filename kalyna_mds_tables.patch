+/* --- MDS transform tables ------------------------------------------------
+ * T[b][v] is the 64-bit contribution of input byte b holding value v to the
+ * output word, i.e. XOR over rows of ( GF(v, matrix[row][b]) << (row*8) ).
+ * MatrixMultiply then costs 8 lookups + 8 XORs per column instead of 512
+ * calls to MultiplyGF.  16 KB per matrix. */
+static uint64_t T_enc[8][256];
+static uint64_t T_dec[8][256];
+static void tt_build(uint64_t T[8][256], uint8_t m[8][8]) {
+    int bb, v, row;
+    for (bb = 0; bb < 8; ++bb)
+        for (v = 0; v < 256; ++v) {
+            uint64_t w = 0;
+            for (row = 0; row < 8; ++row)
+                w |= (uint64_t)MultiplyGF_slow((uint8_t)v, m[row][bb]) << (row * 8);
+            T[bb][v] = w;
+        }
+}
+static void tt_init(void) { tt_build(T_enc, mds_matrix); tt_build(T_dec, mds_inv_matrix); tt_ready = 1; }
